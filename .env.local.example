
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for the Team page's "invite teammate" feature. This is
# the "service_role" secret key from the same Project Settings → API
# page. Treat it like a password: it bypasses all security rules.
# - Keep it out of git (this file is a template only).
# - Never prefix it with NEXT_PUBLIC_ — that would ship it to browsers.
# - Add it as a secret/server-only environment variable on your host
#   (Vercel/Netlify) too, the same way as the two values above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
